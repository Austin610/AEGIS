# Export these into your process environment. The CLI does not read .env implicitly.
AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_DATA_DIR=.aegis
# Optional PostgreSQL persistence: set AEGIS_DATABASE_URL through your environment.
# Set POSTGRES_PASSWORD in the environment before starting the database profile.

# Matches the durable mode used by the local launcher.
AEGIS_DURABLE_JOBS=1
# Deletion and recovery expiry are disabled unless explicitly configured.
# See docs/deletion-lifecycle.md and docs/recovery-expiry.md before enabling them.
# GitHub OAuth settings are documented in docs/github-connection.md.
